---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';

// 静态站点在“构建时”就为每篇文章生成一个 HTML 页面
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'posts'> };

const { post } = Astro.props;
const { Content } = await render(post);

// 终端风的补零日期：2026-10-08
const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <p class="text-sm text-term-dim">
      <span class="text-term-green">$</span> cat ~/posts/{post.id}.md
    </p>
    <h1 class="mt-4 text-2xl font-bold">{post.data.title}</h1>
    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-term-dim">
      <time datetime={post.data.pubDate.toISOString()} class="text-term-amber">
        {fmt(post.data.pubDate)}
      </time>
      {post.data.updatedDate && <span>updated {fmt(post.data.updatedDate)}</span>}
      {post.data.tags.map((tag) => <span>#{tag}</span>)}
    </div>

    <!-- Markdown 正文渲染到此处；prose 类来自 @tailwindcss/typography 插件 -->
    <div class="prose prose-gray mt-8 dark:prose-invert">
      <Content />
    </div>
  </article>

  <Giscus />
</BaseLayout>
